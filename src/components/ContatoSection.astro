<section id="contatos" class="contact section light-background">
  <div class="container section-title" data-aos="fade-up">
    <h2>Contato</h2>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row gy-5 align-items-stretch">
      <div class="col-lg-5" data-aos="fade-right" data-aos-delay="200">
        <div class="info-panel">
          <div class="panel-header">
            <h3>Fale com a Tumo</h3>
            <p>Cada projeto tem uma necessidade diferente. Vamos avaliar a melhor forma de construir a solução ideal para o seu negócio.</p>
          </div>

          <div class="contact-methods">
            <div class="method-item">
              <div class="method-icon">
                <i class="ti ti-mail-forward"></i>
              </div>
              <div class="method-details">
                <span class="method-label">Email</span>
                <a href="mailto:contato@tumo.com.br">contato@tumo.com.br</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-7" data-aos="fade-left" data-aos-delay="300">
        <div class="form-card">
          <div class="form-card-header">
            <div class="header-icon">
              <i class="ti ti-message-circle-share"></i>
            </div>
            <div class="header-text">
              <h4>Seu projeto começa com uma conversa</h4>
              <p>Entender o problema é o primeiro passo para criar a solução certa. Fale com a Tumo e vamos construir juntos a melhor solução.</p>
            </div>
          </div>

          <form class="php-email-form" onsubmit="event.preventDefault(); alert('Formulário ainda não integrado. No próximo passo, posso conectar isso ao Resend.');">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="input-group-custom">
                  <label for="nome">Nome</label>
                  <div class="input-wrapper">
                    <i class="ti ti-user"></i>
                    <input type="text" name="nome" id="nome" placeholder="Digite o nome" />
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="input-group-custom">
                  <label for="email">Email</label>
                  <div class="input-wrapper">
                    <i class="ti ti-mail"></i>
                    <input type="email" name="email" id="email" placeholder="Digite o email" />
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="input-group-custom">
                  <label for="assunto">Assunto</label>
                  <div class="input-wrapper">
                    <i class="ti ti-message"></i>
                    <input type="text" name="assunto" id="assunto" placeholder="Digite o assunto" />
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="input-group-custom">
                  <label for="mensagem">Mensagem</label>
                  <div class="input-wrapper textarea-wrapper">
                    <i class="ti ti-message-circle"></i>
                    <textarea name="mensagem" id="mensagem" rows="5" placeholder="Nos conte sobre o seu projeto..."></textarea>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-submit">
                <span>Enviar</span>
                <i class="ti ti-circle-arrow-right-filled"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
