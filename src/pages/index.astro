---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import ApresentacaoSection from '../components/ApresentacaoSection.astro';
import SobreSection from '../components/SobreSection.astro';
import ServicosSection from '../components/ServicosSection.astro';
import CtaSection from '../components/CtaSection.astro';
import ProcessoSection from '../components/ProcessoSection.astro';
import ClientesSection from '../components/ClientesSection.astro';
import ContatoSection from '../components/ContatoSection.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout>
  <Header />
  <main class="main">
    <ApresentacaoSection />
    <SobreSection />
    <ServicosSection />
    <CtaSection />
    <ProcessoSection />
    <ClientesSection />
    <ContatoSection />
  </main>
  <Footer />
</MainLayout>
